# 서버의 /opt/stargazer/.env 형식이다. 평소에는 배포 워크플로(.github/workflows/deploy.yml)가
# GitHub secrets로 채워서 올리고, 손으로 띄울 때만 이 파일을 복사해 채운다. .env는 커밋하지 않는다.
APP_IMAGE=ghcr.io/byeolbolil/stargazer-server:latest
# 도메인이 있으면 도메인(자동 HTTPS), 없으면 :80
SITE_ADDRESS=api.byeolbolil.xyz

DB_USERNAME=stargazer
DB_PASSWORD=
JWT_KEY=
# 비워 두면 MET Norway 폴백을 쓰지 않는다
MET_NORWAY_USER_AGENT=

# OAuth2 웹 로그인 흐름에만 쓰이지만 application.yml이 빈 값을 허용하지 않아 자리를 채워야 기동한다
SERVER_BASE_URL=https://api.byeolbolil.xyz
CLIENT_REDIRECT_BASE_URL=https://www.byeolbolil.xyz
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
